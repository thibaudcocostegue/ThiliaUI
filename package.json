{
  "name": "thiliaui",
  "version": "0.0.0",
  "private": true,
  "description": "Bibliothèque de composants Vue 3.",
  "license": "MIT",
  "author": "Thibaud Maciuk",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./style.css": "./dist/style.css"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "npm run typecheck && vite build && vue-tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test:consumer": "node tests/consumer/run.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}
